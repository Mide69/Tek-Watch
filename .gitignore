# Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/
.mypy_cache/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# The workflows and the runbook both write plan files as "tfplan-prod" /
# "tfplan-dev", with no extension, so *.tfplan above does not cover them. A
# plan is a full snapshot of the resource graph with attribute values, and
# this repo is public.
tfplan-*
.terraform.lock.hcl
**/silence_detector.zip

# Docker
.dockerignore

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Dev tool configs (local only)
.claude/
.kiro/

# Logs
*.log
logs/

# Local terraform overrides holding personal/sensitive values (e.g. the ops
# alert email). Terraform auto-loads *.auto.tfvars; this repo is public, so
# those values must not be committed. environments/*.tfvars stay tracked.
*.auto.tfvars
