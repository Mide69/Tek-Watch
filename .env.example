# Tribe Watch Environment Variables
# Copy to .env.local for local development

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-2
ENVIRONMENT=dev

# ── Agent (customer AWS account) ─────────────────────────────────────────────
TRIBE_WATCH_CUSTOMER_ID=TT-0001
TRIBE_WATCH_INGEST_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/123456789012/tribe-watch-dev-ingest
TRIBE_WATCH_API_KEY=your-api-key-here

# ── API & Ingest Consumer ─────────────────────────────────────────────────────
# Production: set SECRETS_MANAGER_SECRET_ARN and leave the rest blank
# Dev: set individual vars below
SECRETS_MANAGER_SECRET_ARN=

TIMESTREAM_DATABASE_NAME=tribe-watch-dev
TIMESTREAM_METRICS_TABLE=metrics
TIMESTREAM_EVENTS_TABLE=events

DYNAMODB_CUSTOMERS_TABLE=tribe-watch-dev-customers
DYNAMODB_ALERTS_TABLE=tribe-watch-dev-alerts
DYNAMODB_THRESHOLDS_TABLE=tribe-watch-dev-thresholds

COGNITO_CUSTOMER_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_CUSTOMER_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ADMIN_USER_POOL_ID=eu-west-2_YYYYYYYYY
COGNITO_ADMIN_APP_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SNS_OPS_ALERTS_TOPIC_ARN=arn:aws:sns:eu-west-2:123456789012:tribe-watch-dev-ops-alerts

SQS_INGEST_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/123456789012/tribe-watch-dev-ingest

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dashboard (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_COGNITO_REGION=eu-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin Portal (Next.js) ────────────────────────────────────────────────────
# Uses same NEXT_PUBLIC_* vars but pointing to admin Cognito pool
# Set in admin-portal/.env.local:
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-2_YYYYYYYYY
# NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy

# ── LocalStack (local dev only) ───────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
