{
  "id": "uk-aws-2026-10",
  "version": "1.0.0",
  "effective_from": "2026-10-18",
  "jurisdiction": "UK",
  "scope": "selected AWS technical controls only",
  "review_status": "engineering baseline; independent regulatory review pending",
  "frameworks": [
    {
      "id": "uk_gdpr",
      "name": "UK GDPR"
    },
    {
      "id": "cyber_essentials",
      "name": "Cyber Essentials v3.3",
      "scope": "cloud_controls_only",
      "scope_note": "The cloud side only. From an AWS account TekWatch can evidence firewalls and internet gateways, secure configuration, user access control, and the cloud half of security update management, such as functions left on retired runtimes. Malware protection, and patching on the laptops and phones your people use, are not visible to TekWatch and are not assessed here. Version 3.3 applies to assessments from 27 April 2026 and puts cloud services firmly in scope."
    },
    {
      "id": "iso27001",
      "name": "ISO 27001:2022"
    },
    {
      "id": "fca_ps21_3",
      "name": "FCA PS21/3 operational resilience",
      "scope": "technical_evidence_only",
      "scope_note": "Technical evidence only. These checks show whether the AWS resources behind a service can survive a failure and be restored, which supports the resource mapping a firm must do under PS21/3. Identifying important business services, setting impact tolerances and scenario testing are governance work that cannot be read from AWS configuration, and are not assessed here."
    }
  ],
