# ─── Tek Watch API — Environment Variables ────────────────────────────────────
# Copy to .env and fill in your values for local development.
# In production, values are loaded from AWS Secrets Manager.

# AWS
AWS_REGION=eu-west-2
ENVIRONMENT=dev                  # dev | staging | prod
LOG_LEVEL=INFO

# Leave blank in dev (env vars below will be used instead of Secrets Manager)
SECRETS_MANAGER_SECRET_ARN=

# ─── DynamoDB ────────────────────────────────────────────────────────────────
DYNAMODB_CUSTOMERS_TABLE=tek_watch_customers
DYNAMODB_ALERTS_TABLE=tek_watch_alerts
DYNAMODB_THRESHOLDS_TABLE=tek_watch_thresholds

# ─── Timestream ──────────────────────────────────────────────────────────────
TIMESTREAM_DATABASE_NAME=tek-watch
TIMESTREAM_METRICS_TABLE=metrics
TIMESTREAM_EVENTS_TABLE=events

# ─── Cognito ─────────────────────────────────────────────────────────────────
COGNITO_CUSTOMER_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_CUSTOMER_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ADMIN_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_ADMIN_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── SNS / SES ───────────────────────────────────────────────────────────────
SNS_OPS_ALERTS_TOPIC_ARN=arn:aws:sns:eu-west-2:123456789012:tek-watch-ops-alerts

# SES — set to enable customer email notifications
SES_FROM_EMAIL=alerts@tekwatch.io

# ─── Slack ───────────────────────────────────────────────────────────────────
# Optional — per-customer webhooks are stored in DynamoDB, this is a global default
SLACK_WEBHOOK_URL=

# ─── SQS ─────────────────────────────────────────────────────────────────────
SQS_INGEST_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/123456789012/tek-watch-ingest

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.tekwatch.io,https://admin.tekwatch.io
