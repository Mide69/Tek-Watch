# Production build defaults for the PUBLIC DEMO (Vercel, zero-cost static host).
#
# These are all NEXT_PUBLIC_* values — public by definition, no secrets here.
# DEMO_MODE=true makes the dashboard render realistic mock data with no backend,
# so the static export is fully self-contained (no API/Cognito needed). This is
# the fallback for any production build; a real backend deploy (e.g. GitHub
# Actions -> S3/CloudFront against live AWS) overrides these by setting the same
# vars explicitly at build time, which take precedence over this file.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=https://api.tekwatch.io
NEXT_PUBLIC_COGNITO_REGION=eu-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=placeholder
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=placeholder
