# ─── Tek Watch Dashboard — Environment Variables ─────────────────────────────
# Copy to .env.local and fill in your values.

# API — defaults to localhost in dev, swap to your deployed API URL in staging/prod
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Cognito — obtain from Terraform outputs or AWS Console
NEXT_PUBLIC_COGNITO_REGION=eu-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to "true" to bypass auth and use mock data (local dev only)
NEXT_PUBLIC_DEMO_MODE=true
