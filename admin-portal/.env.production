# Production build defaults for the PUBLIC ADMIN DEMO (Vercel, zero-cost).
#
# All NEXT_PUBLIC_* (public by definition, no secrets). DEMO_MODE=true bypasses
# Cognito auth and makes the API client return mock data (see lib/demoData.ts),
# so the admin portal runs fully self-contained with no AWS backend. A real
# deploy overrides these by setting the vars explicitly at build time.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=https://api.tekwatch.io
NEXT_PUBLIC_COGNITO_REGION=eu-west-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=placeholder
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=placeholder
